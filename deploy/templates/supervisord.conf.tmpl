[program:app]
command=uv run uvicorn --factory $factory --host 127.0.0.1 --port $internal_port
directory=/app
environment=KBC_ACCESS_CONFIG="/app/config/deployed.toml",PYTHONPATH="/app/src:/app"
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
